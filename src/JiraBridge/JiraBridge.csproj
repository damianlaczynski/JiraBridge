<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JiraBridge</RootNamespace>
    <AssemblyName>JiraBridge</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jirabridge</ToolCommandName>
    <PackageId>JiraBridge</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Authors>Damian Łączyński</Authors>
    <Description>Interactive CLI for syncing a Git-hosted markdown backlog with Jira (pull, push, validate, conflicts).</Description>
    <PackageTags>jira;cli;dotnet-tool;sync;backlog;interactive</PackageTags>
    <PackageProjectUrl>https://github.com/DamianLaczynski/JiraBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DamianLaczynski/JiraBridge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Damian Łączyński</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
